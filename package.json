    "db:functions": "dotenv -e .env.local -- node scripts/apply-functions.mjs",
    "db:setup": "npm run db:migrate && npm run db:functions"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
